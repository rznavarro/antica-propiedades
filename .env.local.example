# Mapbox access token (público, se usa en el navegador).
# Consíguelo gratis en https://account.mapbox.com/access-tokens/
# Copia este archivo a .env.local y pega tu token ahí (no subir .env.local a git).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend API key (opcional) para que el formulario de contacto envíe
# el email real a contacto@anticapropiedades.cl. Sin esto, el formulario
# sigue funcionando pero solo deja el mensaje en el log del servidor.
# https://resend.com
RESEND_API_KEY=
